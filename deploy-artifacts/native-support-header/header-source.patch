+// Fixed standards-compliant QR matrix, including four quiet-zone modules.
+const _supportRevolutQrModules = <String>[
+  '000000000000000000000000000000000',
+  '000000000000000000000000000000000',
+  '000000000000000000000000000000000',
+  '000000000000000000000000000000000',
+  '000011111110100001100011111110000',
+  '000010000010110111001010000010000',
+  '000010111010111011110010111010000',
+  '000010111010010001111010111010000',
+  '000010111010111101101010111010000',
+  '000010000010000001101010000010000',
+  '000011111110101010101011111110000',
+  '000000000000000111011000000000000',
+  '000010011111101100101100101110000',
+  '000000110001101011111001111100000',
+  '000001010111100000110010010010000',
+  '000000001001110110100010011110000',
+  '000011001010000010010010000010000',
+  '000011011000001011011100100100000',
+  '000011011110110010010110111110000',
+  '000010010101101100100001011010000',
+  '000010110110110111011111101100000',
+  '000000000000110001011000101100000',
+  '000011111110110101101010100010000',
+  '000010000010100011011000100000000',
+  '000010111010111010111111100000000',
+  '000010111010110100101110000110000',
+  '000010111010001100001100111110000',
+  '000010000010010100000001101110000',
+  '000011111110100110001000010010000',
+  '000000000000000000000000000000000',
+  '000000000000000000000000000000000',
+  '000000000000000000000000000000000',
+  '000000000000000000000000000000000',
+];
+
+class _SupportRevolutQrPainter extends CustomPainter {
+  const _SupportRevolutQrPainter();
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    canvas.drawRect(Offset.zero & size, Paint()..color = Colors.white);
+    final ink = Paint()..color = Colors.black..isAntiAlias = false;
+    final stepX = size.width / _supportRevolutQrModules.length;
+    final stepY = size.height / _supportRevolutQrModules.length;
+    for (var y = 0; y < _supportRevolutQrModules.length; y++) {
+      final row = _supportRevolutQrModules[y];
+      for (var x = 0; x < row.length; x++) {
+        if (row.codeUnitAt(x) == 49) {
+          canvas.drawRect(Rect.fromLTRB(x * stepX, y * stepY,
+            (x + 1) * stepX, (y + 1) * stepY), ink);
+        }
+      }
+    }
+  }
+
+  @override
+  bool shouldRepaint(_SupportRevolutQrPainter oldDelegate) => false;
+}
